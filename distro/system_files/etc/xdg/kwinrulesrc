# The Nuri AI panel opens centred, above other windows, and stays out of
# the task bar and pager - like a launcher, not a document window.
[General]
count=2
rules=nuri-assistant,nuri-control

[nuri-assistant]
Description=Nuri AI panel
wmclass=nuri-assistant
wmclassmatch=1
placement=5
placementrule=2
above=true
aboverule=2
skiptaskbar=true
skiptaskbarrule=2
skippager=true
skippagerrule=2
noborder=true
noborderrule=2

# Control Center: drops down under the pointer (opened from the top bar),
# above other windows, out of the task bar.
[nuri-control]
Description=Nuri Control Center
wmclass=nuri-control
wmclassmatch=1
placement=7
placementrule=2
above=true
aboverule=2
skiptaskbar=true
skiptaskbarrule=2
skippager=true
skippagerrule=2
noborder=true
noborderrule=2
