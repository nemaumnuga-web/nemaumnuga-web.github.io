# Copy to ~/.config/nuri/ai.env and edit, then: systemctl --user restart nuri-ai
#
# Context window in tokens. Bigger = longer memory per request, more RAM.
# Long conversations are summarised by `nuri-ai chat`, so 8192 is enough on 8 GB.
NURI_CTX=8192
# CPU threads (0 = automatic)
NURI_THREADS=0
# Port on 127.0.0.1
NURI_PORT=8765
# Extra llama-server flags, e.g. GPU offload:
# NURI_EXTRA_ARGS="--n-gpu-layers 99"
