#!/usr/bin/python3
"""nuri-ai - on-device AI for Nuri OS.

Picks a local model that fits this machine and language, downloads it with
integrity checks, and chats with it through the local llama.cpp server.
Models, settings and chat history never leave this computer.

  nuri-ai status                 machine, language, active model, server state
  nuri-ai list [--lang ko] [--all]
  nuri-ai install <model-id> [--accept-license]
  nuri-ai use <model-id>
  nuri-ai remove <model-id>
  nuri-ai chat [--session NAME]  interactive chat, history kept on disk
  nuri-ai ask "question"         one-shot question (scripts, shortcuts)
"""
import argparse
import hashlib
import json
import locale
import os
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

# ---------------------------------------------------------------- paths/config

REGISTRY_CANDIDATES = [os.environ.get("NURI_REGISTRY"), "/usr/share/nuri/models.json"]
DATA = Path(os.environ.get("NURI_DATA") or Path.home() / ".local/share/nuri")
CONFIG = Path(os.environ.get("NURI_CONFIG") or Path.home() / ".config/nuri")
MODELS = DATA / "models"
CURRENT = MODELS / "current.gguf"
CHATS = DATA / "chats"
HF = os.environ.get("NURI_HF_ENDPOINT", "https://huggingface.co").rstrip("/")
SERVER = os.environ.get("NURI_AI_URL") or "http://127.0.0.1:%s" % os.environ.get("NURI_PORT", "8765")
LABELS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

MSG = {
    "ko": {
        "rec": "추천", "installed": "설치됨", "active": "사용 중", "nc": "비상업 전용",
        "unofficial": "비공식 변환본(검증 필요)", "nofit": "이 PC 메모리로는 맞는 모델이 없어요.",
        "accept": "이 라이선스에 동의하고 내려받을까요? [y/N] ",
        "need_accept": "라이선스 동의가 필요해요. --accept-license 를 붙여 다시 실행하세요.",
        "verify_fail": "무결성 검사 실패: 파일이 손상됐거나 바뀌었어요. 삭제했어요.",
        "net_fail": "내려받기 실패(네트워크). 같은 명령을 다시 실행하면 이어서 받아요:",
        "done": "설치 완료", "now_using": "이제 이 모델을 사용해요", "no_server":
        "AI 서버가 응답하지 않아요. 'systemctl --user start nuri-ai' 를 실행해 보세요.",
        "bye": "대화는 이 PC에만 저장됐어요:",
    },
    "en": {
        "rec": "recommended", "installed": "installed", "active": "active", "nc": "non-commercial only",
        "unofficial": "unofficial conversion (verify)", "nofit": "No model fits this machine's memory.",
        "accept": "Accept this license and download? [y/N] ",
        "need_accept": "License acceptance required. Re-run with --accept-license.",
        "verify_fail": "Integrity check failed: the file is corrupt or changed. Deleted it.",
        "net_fail": "Download failed (network). Run the same command again to resume:",
        "done": "Installed", "now_using": "Now using", "no_server":
        "The AI server is not responding. Try 'systemctl --user start nuri-ai'.",
        "bye": "Chat saved on this computer only:",
    },
}


def ui_lang():
    lang = (os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "")
    if not lang:
        lang = (locale.getlocale()[0] or "en")
    return lang[:2].lower() or "en"


def t(key):
    return MSG.get(ui_lang(), MSG["en"])[key]


def die(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


# ---------------------------------------------------------------- registry

def load_registry():
    for p in REGISTRY_CANDIDATES:
        if p and Path(p).is_file():
            with open(p, encoding="utf-8") as f:
                return json.load(f)
    die("model registry not found (looked in %s)" % ", ".join(p for p in REGISTRY_CANDIDATES if p))


def find_model(reg, model_id):
    for m in reg["models"]:
        if m["id"] == model_id:
            return m
    die("unknown model: %s  (see 'nuri-ai list --all')" % model_id)


def total_ram_gb():
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    return int(line.split()[1]) / 1024 / 1024
    except OSError:
        pass
    return 8.0


def fits(model, ram_gb):
    # An "8 GB" laptop reports ~7.5 GB to the OS; allow that slack.
    return ram_gb >= model["min_ram_gb"] * 0.9


def recommendations(reg, lang, ram_gb, show_all=False):
    """Models for this language and machine, best first.

    Order: models recommended for the language, then the language's other
    models, then multilingual ones. Within a group, the biggest hardware
    class that still fits this machine comes first (a 16 GB PC should not be
    offered a 1B model first), then the curated rank, then size."""
    out = []
    for m in reg["models"]:
        if not show_all and not fits(m, ram_gb):
            continue
        langs = m.get("langs", [])
        if not show_all and lang not in langs and "*" not in langs:
            continue
        out.append(m)

    def key(m):
        rank = m.get("recommend", {}).get(lang)
        group = 0 if rank else (1 if lang in m.get("langs", []) else 2)
        return (group, -m["min_ram_gb"], rank or 99, -m["params_b"])
    return sorted(out, key=key)


def installed_ids():
    if not MODELS.is_dir():
        return set()
    return {p.name for p in MODELS.iterdir() if (p / "meta.json").is_file()}


def active_id():
    try:
        return CURRENT.resolve(strict=True).parent.name
    except (OSError, RuntimeError):
        return None


# ---------------------------------------------------------------- commands

def cmd_list(args):
    reg = load_registry()
    lang = args.lang or ui_lang()
    ram = total_ram_gb()
    models = recommendations(reg, lang, ram, args.all)
    print("RAM %.1f GB  ·  language: %s\n" % (ram, lang))
    if not models:
        print(t("nofit"))
        return
    inst, act = installed_ids(), active_id()
    for label, m in zip(LABELS, models):
        tags = []
        if m.get("recommend", {}).get(lang):
            tags.append("✨ " + t("rec"))
        if m["id"] == act:
            tags.append("● " + t("active"))
        elif m["id"] in inst:
            tags.append(t("installed"))
        if m.get("commercial") == "no":
            tags.append(t("nc"))
        if m.get("trust") == "repackaged":
            tags.append("⚠ " + t("unofficial"))
        size = "%.1f GB" % (m["size"] / 1e9) if m.get("size") else "?"
        print(" %s. %-22s %-26s %5.1fB  %8s  %-14s %s" % (
            label, m["id"], m["name"], m["params_b"], size, m["license"], "  ".join(tags)))
    print("\nnuri-ai install <id>")


def http_get_json(url, timeout=10):
    with urllib.request.urlopen(url, timeout=timeout) as r:
        return json.load(r)


def server_ok():
    try:
        return http_get_json(SERVER + "/health", timeout=2).get("status") == "ok"
    except (OSError, ValueError, urllib.error.URLError):
        return False


def cmd_status(args):
    reg = load_registry()
    act = active_id()
    print("RAM          %.1f GB" % total_ram_gb())
    print("language     %s" % ui_lang())
    print("registry     %s models (v%s)" % (len(reg["models"]), reg.get("version", "?")))
    print("installed    %s" % (", ".join(sorted(installed_ids())) or "-"))
    print("active       %s" % (act or "-"))
    print("server       %s (%s)" % ("running" if server_ok() else "stopped", SERVER))
    print("data         %s" % DATA)


def download(url, dest, sha256, size=None):
    """Stream url to dest.part, verifying sha256; resumes partial downloads."""
    part = dest.with_name(dest.name + ".part")
    h = hashlib.sha256()
    have = 0
    if part.exists():
        with open(part, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""):
                h.update(chunk)
                have += len(chunk)
    req = urllib.request.Request(url, headers={"User-Agent": "nuri-ai/0.1"})
    if have:
        req.add_header("Range", "bytes=%d-" % have)
    with urllib.request.urlopen(req, timeout=60) as r:
        if have and r.status != 206:  # server ignored Range: start over
            h, have = hashlib.sha256(), 0
            mode = "wb"
        else:
            mode = "ab" if have else "wb"
        total = size or (have + int(r.headers.get("Content-Length") or 0))
        last = 0.0
        with open(part, mode) as f:
            for chunk in iter(lambda: r.read(1 << 20), b""):
                f.write(chunk)
                h.update(chunk)
                have += len(chunk)
                if sys.stderr.isatty() and time.time() - last > 0.5:
                    last = time.time()
                    pct = 100 * have / total if total else 0
                    print("\r  %.0f%%  %.2f / %.2f GB" % (pct, have / 1e9, total / 1e9),
                          end="", file=sys.stderr)
    if sys.stderr.isatty():
        print(file=sys.stderr)
    if h.hexdigest() != sha256:
        part.unlink(missing_ok=True)
        die(t("verify_fail"))
    os.replace(part, dest)


def set_active(model_id, filename):
    tmp = MODELS / ".current.tmp"
    tmp.unlink(missing_ok=True)
    tmp.symlink_to(Path(model_id) / filename)
    os.replace(tmp, CURRENT)  # atomic switch
    if shutil.which("systemctl"):
        subprocess.run(["systemctl", "--user", "restart", "nuri-ai.service"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cmd_install(args):
    reg = load_registry()
    m = find_model(reg, args.model)
    if not (m.get("file") and m.get("sha256")):
        die("registry entry %s is not pinned (file/sha256 missing)" % m["id"])
    print("%s  (%s)" % (m["name"], m["repo"]))
    print("license: %s  %s" % (m["license"], m.get("license_url", "")))
    if m.get("commercial") == "no":
        print("  -> " + t("nc"))
    if m.get("trust") == "repackaged":
        print("  -> ⚠ " + t("unofficial"))
    if m.get("notes"):
        print("  " + m["notes"])
    if not args.accept_license:
        if not sys.stdin.isatty():
            die(t("need_accept"))
        if input(t("accept")).strip().lower() not in ("y", "yes", "ㅇ", "네", "예"):
            die("cancelled", 0)
    target = MODELS / m["id"]
    target.mkdir(parents=True, exist_ok=True)
    dest = target / m["file"]
    if not dest.exists():
        url = "%s/%s/resolve/%s/%s" % (HF, m["repo"], m.get("revision", "main"), m["file"])
        try:
            download(url, dest, m["sha256"], m.get("size"))
        except (OSError, urllib.error.URLError) as e:
            die("%s %s" % (t("net_fail"), getattr(e, "reason", e)))
    meta = {k: m.get(k) for k in ("id", "name", "repo", "revision", "file", "sha256", "license")}
    meta["installed_at"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    (target / "meta.json").write_text(json.dumps(meta, ensure_ascii=False, indent=1), encoding="utf-8")
    print(t("done") + ": " + m["id"])
    if args.use or active_id() is None:
        set_active(m["id"], m["file"])
        print(t("now_using") + ": " + m["id"])


def cmd_use(args):
    reg = load_registry()
    m = find_model(reg, args.model)
    if m["id"] not in installed_ids():
        die("not installed: %s  (nuri-ai install %s)" % (m["id"], m["id"]))
    set_active(m["id"], m["file"])
    print(t("now_using") + ": " + m["id"])


def cmd_remove(args):
    target = MODELS / args.model
    if not target.is_dir():
        die("not installed: " + args.model)
    if active_id() == args.model:
        CURRENT.unlink(missing_ok=True)
    shutil.rmtree(target)
    print("removed " + args.model)


# ---------------------------------------------------------------- chat
#
# Long conversations: the full transcript is always kept on disk. What is sent
# to the model is   system prompt + running summary + the most recent turns,
# kept under a token budget. When recent turns overflow the budget, the oldest
# ones are folded into the summary by the model itself.

SYSTEM_PROMPT = {
    "ko": "너는 Nuri OS에 내장된 개인 비서야. 사용자의 컴퓨터 안에서만 동작하고, 대화는 외부로 나가지 않아. 한국어로 간결하고 정확하게 답해.",
    "en": "You are the assistant built into Nuri OS. You run entirely on the user's computer and nothing leaves it. Answer concisely and accurately.",
}
MEMORY_HEADER = {
    "ko": "[이 대화에서 기억하는 사실 - 질문에 답할 때 반드시 활용해]",
    "en": "[Earlier in this conversation - facts to use when answering]",
}
SUMMARY_PROMPT = {
    "ko": ("아래 '기존 메모'와 '새 대화'를 합쳐 메모를 새로 써. 사용자에 대한 사실(이름, 사는 곳, "
           "좋아하는 것, 계획, 결정, 부탁한 일)만 '- ' 로 시작하는 짧은 항목으로 적어. "
           "대화를 그대로 옮기지 말고, 인사말이나 비서의 조언은 빼. 15개 항목 이내.\n\n"
           "기존 메모:\n%s\n\n새 대화:\n%s"),
    "en": ("Rewrite the notes by merging the 'current notes' and the 'new turns'. Keep only facts "
           "about the user (name, location, preferences, plans, decisions, requests) as short "
           "items starting with '- '. Do not copy the dialogue; drop greetings and the "
           "assistant's advice. At most 15 items.\n\nCurrent notes:\n%s\n\nNew turns:\n%s"),
}


def est_tokens(text):
    # Rough: ~1 token per 3 chars covers English; Korean is denser per char,
    # so this over-estimates there, which is the safe side for a budget.
    return len(text) // 3 + 4


class Session:
    def __init__(self, name, ctx_tokens=None):
        CHATS.mkdir(parents=True, exist_ok=True)
        self.path = CHATS / (name + ".json")
        self.ctx = ctx_tokens or int(os.environ.get("NURI_CTX", "8192"))
        self.budget = int(self.ctx * 0.55)  # leave room for the answer
        self.data = {"summary": "", "recent": [], "log": []}
        if self.path.exists():
            self.data = json.loads(self.path.read_text(encoding="utf-8"))

    def save(self):
        tmp = self.path.with_suffix(".tmp")
        tmp.write_text(json.dumps(self.data, ensure_ascii=False, indent=1), encoding="utf-8")
        os.replace(tmp, self.path)

    def messages(self):
        lang = ui_lang() if ui_lang() in SYSTEM_PROMPT else "en"
        sys_prompt = SYSTEM_PROMPT[lang]
        if self.data["summary"]:
            sys_prompt += "\n\n" + MEMORY_HEADER[lang] + "\n" + self.data["summary"]
        return [{"role": "system", "content": sys_prompt}] + self.data["recent"]

    def size(self):
        return sum(est_tokens(m["content"]) for m in self.messages())

    def add(self, role, content):
        msg = {"role": role, "content": content}
        self.data["recent"].append(msg)
        self.data["log"].append(dict(msg, ts=time.time()))

    def compact(self, summarize):
        """Fold the oldest turns into the summary until under budget."""
        while self.size() > self.budget and len(self.data["recent"]) > 2:
            cut = max(2, len(self.data["recent"]) // 2)
            cut -= cut % 2  # keep user/assistant pairs together
            old, self.data["recent"] = self.data["recent"][:cut], self.data["recent"][cut:]
            transcript = "\n".join("%s: %s" % (m["role"], m["content"]) for m in old)
            self.data["summary"] = summarize(self.data["summary"], transcript)


def complete(messages, stream_to=None, max_tokens=1024):
    payload = {"messages": messages, "stream": stream_to is not None,
               "max_tokens": max_tokens, "temperature": 0.7}
    # Reasoning models (Qwen3.x, gpt-oss, ...) otherwise spend hundreds of
    # hidden "thinking" tokens per turn - minutes on a CPU. Opt in with NURI_THINK=1.
    if os.environ.get("NURI_THINK") != "1":
        payload["chat_template_kwargs"] = {"enable_thinking": False}
    body = json.dumps(payload).encode()
    req = urllib.request.Request(SERVER + "/v1/chat/completions", data=body,
                                 headers={"Content-Type": "application/json"})
    try:
        r = urllib.request.urlopen(req, timeout=600)
    except (OSError, urllib.error.URLError):
        die(t("no_server"))
    streaming = stream_to is not None
    with r:
        if not streaming:
            return json.load(r)["choices"][0]["message"]["content"]
        out = []
        for raw in r:
            line = raw.decode("utf-8", "replace").strip()
            if not line.startswith("data:") or line == "data: [DONE]":
                continue
            delta = json.loads(line[5:])["choices"][0].get("delta", {}).get("content") or ""
            out.append(delta)
            if stream_to is not None:
                try:
                    stream_to.write(delta)
                    stream_to.flush()
                except (BrokenPipeError, ValueError):
                    # Reader went away (e.g. piped into `head`): keep receiving
                    # so the full answer is still saved to the chat history.
                    stream_to = None
        if stream_to is not None:
            try:
                stream_to.write("\n")
            except (BrokenPipeError, ValueError):
                pass
        return "".join(out)


def summarize(prev, transcript):
    lang = ui_lang() if ui_lang() in SUMMARY_PROMPT else "en"
    prompt = SUMMARY_PROMPT[lang] % (prev or "-", transcript)
    return complete([{"role": "user", "content": prompt}], max_tokens=400).strip()


def turn(session, text, out):
    session.add("user", text)
    session.compact(summarize)
    answer = complete(session.messages(), stream_to=out)
    session.add("assistant", answer)
    session.save()
    return answer


def cmd_chat(args):
    if not server_ok():
        die(t("no_server"))
    s = Session(args.session)
    print("(Ctrl-D: quit)")
    while True:
        try:
            text = input("\n> ").strip()
        except (EOFError, KeyboardInterrupt):
            print("\n%s %s" % (t("bye"), s.path))
            return
        if text:
            turn(s, text, sys.stdout)


def cmd_ask(args):
    if not server_ok():
        die(t("no_server"))
    turn(Session(args.session), " ".join(args.question), sys.stdout)


# ---------------------------------------------------------------- main

def main(argv=None):
    ap = argparse.ArgumentParser(prog="nuri-ai", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("status").set_defaults(fn=cmd_status)
    p = sub.add_parser("list")
    p.add_argument("--lang", help="language code, e.g. ko, en, ja (default: system language)")
    p.add_argument("--all", action="store_true", help="show every model, even ones that do not fit")
    p.set_defaults(fn=cmd_list)
    p = sub.add_parser("install")
    p.add_argument("model")
    p.add_argument("--accept-license", action="store_true")
    p.add_argument("--use", action="store_true", help="switch to it after installing")
    p.set_defaults(fn=cmd_install)
    p = sub.add_parser("use"); p.add_argument("model"); p.set_defaults(fn=cmd_use)
    p = sub.add_parser("remove"); p.add_argument("model"); p.set_defaults(fn=cmd_remove)
    p = sub.add_parser("chat"); p.add_argument("--session", default="default"); p.set_defaults(fn=cmd_chat)
    p = sub.add_parser("ask"); p.add_argument("question", nargs="+")
    p.add_argument("--session", default="ask"); p.set_defaults(fn=cmd_ask)
    args = ap.parse_args(argv)
    MODELS.mkdir(parents=True, exist_ok=True)
    args.fn(args)


if __name__ == "__main__":
    main()
