#!/usr/bin/python3
"""nuri-ai: command-line front end for Nuri OS's on-device AI. See nuri_ai.py."""
import signal
import sys
from pathlib import Path

# /usr/bin -> /usr/lib/nuri (also works from a source checkout of system_files/)
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib/nuri"))

from nuri_ai import main  # noqa: E402

if __name__ == "__main__":
    # `nuri-ai list | head` should end quietly. Chat commands keep the default
    # handling so an answer is still saved when the reader goes away.
    if not set(sys.argv[1:2]) & {"chat", "ask"}:
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    main()
