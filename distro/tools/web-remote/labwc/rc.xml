<?xml version="1.0"?>
<!-- Nuri web remote session: macOS-like window handling on labwc -->
<labwc_config>
  <core>
    <decoration>server</decoration>
    <gap>6</gap>
  </core>
  <placement><policy>center</policy></placement>
  <theme>
    <name>Nuri</name>
    <cornerRadius>11</cornerRadius>
    <dropShadows>yes</dropShadows>
    <titlebar>
      <layout>close,iconify,max:</layout>
      <showTitle>yes</showTitle>
    </titlebar>
    <font place="ActiveWindow"><name>Noto Sans CJK KR</name><size>10</size><weight>bold</weight></font>
    <font place="InactiveWindow"><name>Noto Sans CJK KR</name><size>10</size><weight>bold</weight></font>
    <font place="MenuItem"><name>Noto Sans CJK KR</name><size>10</size></font>
    <font place="OnScreenDisplay"><name>Noto Sans CJK KR</name><size>10</size></font>
  </theme>
  <windowSwitcher preview="yes" outlines="yes">
    <osd show="yes" />
    <fields>
      <field content="icon" width="8%" />
      <field content="title" width="92%" />
    </fields>
  </windowSwitcher>
  <keyboard>
    <default />
    <keybind key="W-space"><action name="Execute" command="nuri-assistant" /></keybind>
    <keybind key="A-space"><action name="Execute" command="nuri-assistant" /></keybind>
    <keybind key="W-e"><action name="Execute" command="dolphin" /></keybind>
    <keybind key="W-c"><action name="Execute" command="nuri-control" /></keybind>
    <keybind key="C-A-t"><action name="Execute" command="konsole" /></keybind>
    <keybind key="W-q"><action name="Close" /></keybind>
    <keybind key="W-m"><action name="Iconify" /></keybind>
  </keyboard>
  <mouse>
    <default />
    <!-- the Nuri menu instead of labwc's own (rounded, icons, touch-sized rows) -->
    <context name="Root">
      <mousebind button="Right" action="Press"><action name="Execute" command="nuri-menu" /></mousebind>
      <mousebind button="Middle" action="Press"><action name="Execute" command="nuri-menu" /></mousebind>
    </context>
    <context name="Title">
      <mousebind button="Left" action="DoubleClick"><action name="ToggleMaximize" /></mousebind>
    </context>
  </mouse>
  <windowRules>
    <!-- desktop menu: centred on the pointer (its own window puts the menu's corner there) -->
    <windowRule identifier="nuri-menu" serverDecoration="no" skipTaskbar="yes" skipWindowSwitcher="yes">
      <action name="AutoPlace" policy="cursor" />
    </windowRule>
    <!-- logo menu: right under the logo in the menu bar -->
    <windowRule identifier="nuri-menu-logo" serverDecoration="no" skipTaskbar="yes" skipWindowSwitcher="yes">
      <action name="MoveTo" x="-4" y="22" />
    </windowRule>
    <!-- Control Center drops down at the top right, under its menu bar button -->
    <windowRule identifier="nuri-control" serverDecoration="no" skipTaskbar="yes" skipWindowSwitcher="yes">
      <action name="MoveToEdge" direction="right" snapWindows="no" />
      <action name="MoveToEdge" direction="up" snapWindows="no" />
    </windowRule>
  </windowRules>
</labwc_config>
